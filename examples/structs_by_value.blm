// structs_by_value.blm — структуры и массивы по значению.
//
// ABI: агрегат размером 1/2/4/8 байт передаётся в регистре как значение,
// всё что больше — указателем на копию, сделанную вызывающим; возврат
// агрегата больше 8 байт идёт через скрытый указатель в RCX.
// Семантика — копирование: изменения внутри функции не видны вызывающему.

struct Vec2 {
    x: int;
    y: int;
}

struct Pf {
    x: float;
    y: float;
}

struct Big {
    pos: Vec2;
    vel: Vec2;
    tag: int;
}

func sumv(v: Vec2) -> int {
    return v.x + v.y;
}

func addv(a: Vec2, b: Vec2) -> Vec2 {
    var r: Vec2;
    r.x = a.x + b.x;
    r.y = a.y + b.y;
    return r;
}

func make_vec(x: int, y: int) -> Vec2 {
    var v: Vec2;
    v.x = x;
    v.y = y;
    return v;
}

func zap(v: Vec2) -> void {
    v.x = 999;
    v.y = 999;
}

func pf_len(p: Pf) -> float {
    return p.x * p.x + p.y * p.y;
}

func make_pf(a: float, b: float) -> Pf {
    var p: Pf;
    p.x = a;
    p.y = b;
    return p;
}

func big_sum(b: Big) -> int {
    return b.pos.x + b.pos.y + b.vel.x + b.vel.y + b.tag;
}

func make_big() -> Big {
    var b: Big;
    b.pos.x = 1;
    b.pos.y = 2;
    b.vel.x = 3;
    b.vel.y = 4;
    b.tag = 5;
    return b;
}

// массив по значению: копия, изменения не выходят наружу
func arr_sum(a: int[3]) -> int {
    a[0] = 100;
    return a[0] + a[1] + a[2];
}

// рекурсия с возвратом структуры по значению
func counters(n: int) -> Vec2 {
    if (n <= 0) {
        return make_vec(0, 0);
    }
    var prev: Vec2 = counters(n - 1);
    return make_vec(prev.x + 1, prev.y + 2);
}

func main() -> int {
    var a: Vec2;
    a.x = 3;
    a.y = 4;
    var b: Vec2;
    b.x = 10;
    b.y = 20;

    print("sumv(a) = ", sumv(a));

    var c: Vec2 = addv(a, b);
    print("a+b = (", c.x, ", ", c.y, ")");

    var m: Vec2 = make_vec(7, 8);
    print("make_vec = (", m.x, ", ", m.y, ")");
    print("sumv(make_vec) = ", sumv(make_vec(4, 5)));
    print("chained = ", sumv(make_vec(sumv(make_vec(1, 2)), 3)));

    // копирование и value-семантика
    var copy: Vec2 = a;
    copy.x = 100;
    print("a = (", a.x, ", ", a.y, ") copy = (", copy.x, ", ", copy.y, ")");
    zap(a);
    print("a after zap = (", a.x, ", ", a.y, ")");

    var d: Vec2;
    d = a;          // присваивание агрегата
    d.y = 42;
    print("d = (", d.x, ", ", d.y, ") a.y = ", a.y);

    // структуры с float-полями
    var p: Pf = make_pf(3.0, 4.0);
    print("pf_len = ", pf_len(p), " p.x = ", p.x);

    // крупная вложенная структура (40 байт)
    var big: Big = make_big();
    print("big_sum = ", big_sum(big), " tag = ", big.tag);
    var big2: Big = big;
    big2.tag = 50;
    print("big.tag = ", big.tag, " big2.tag = ", big2.tag);

    // массив по значению
    var arr: int[3];
    arr[0] = 1;
    arr[1] = 2;
    arr[2] = 3;
    print("arr_sum = ", arr_sum(arr), " arr[0] = ", arr[0]);

    // рекурсия
    var r: Vec2 = counters(5);
    print("counters(5) = (", r.x, ", ", r.y, ")");

    print("sizeof: Vec2=", sizeof(Vec2), " Pf=", sizeof(Pf), " Big=", sizeof(Big));
    return 0;
}
