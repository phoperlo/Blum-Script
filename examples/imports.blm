import "utils.blm";

func fact(n: int) -> int {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

func main() -> int {
    print("square(9) =", square(9));
    print("cube(3) =", cube(3));
    print("fact(6) =", fact(6));

    // Raw machine-code escape: the hex bytes are copied verbatim into .text.
    // 48 c7 c0 2a 00 00 00   mov rax, 42
    // 90 90                   nop nop
    asm {
        48 c7 c0 2a 00 00 00
        90 90
        90 90
    }

    print("raw machine-code block works");

    return 0;
}
